# --- Required -------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Local MongoDB, Atlas URI, or "inmemory" for a throwaway dev database
MONGODB_URI=mongodb://127.0.0.1:27017/arogyakosh
# Use long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
# Comma-separated list of allowed web origins (first one is used in email links)
CLIENT_URL=http://localhost:5173

# --- Optional -------------------------------------------------------------
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
# Public base URL of this API (used for calendar feed links)
PUBLIC_API_URL=http://localhost:5000/api
UPLOAD_DIR=uploads

# AI features (report reading, AI brief summary, assistant). Without a key the
# app still works and the assistant answers from saved records.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Google sign-in (must match VITE_GOOGLE_CLIENT_ID in the client)
GOOGLE_CLIENT_ID=

# Email (verification, password reset, morning digest). Without SMTP, emails
# are printed to the server log in development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ArogyaKosh <no-reply@yourdomain.com>"

# Background jobs (demo cleanup, 07:30 digest). Timezone for the digest.
JOBS_ENABLED=true
TZ=Asia/Kolkata

# WhatsApp dose check-off (Meta WhatsApp Business Cloud API). Leave empty to use the in-app simulator.
# Webhook URL to register in Meta: https://<your-api-host>/api/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Approved templates for messages sent outside the 24-hour window.
# Dose template body params: {{1}} names, {{2}} time, {{3}} medicines. Opt-in params: {{1}} who set it up, {{2}} name.
WHATSAPP_TEMPLATE_DOSE=
WHATSAPP_TEMPLATE_OPTIN=
WHATSAPP_TEMPLATE_LANG=en
